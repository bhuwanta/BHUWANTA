# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignore Real Estate DB Schemas
DB_Schemas.sql

# Ignore local doubts
src/app/(REALESTATE_SOFTWARE)/REALESTATE_SOFTWARE/Doubts/

# ngrok runtime log — regenerated on every tunnel, nothing depends on it
ngrok.log

# one-off debug/migration scripts run by hand from the repo root
# (add_email_col.js, scratch.ts, test_query.ts and friends). Nothing
# imports them and they tend to hold ad-hoc DB pokes, so keep new ones
# out of the repo rather than re-committing the same clutter.
/scratch*.js
/scratch*.ts
/test_*.ts
/test_*.js
/add_*.js
/add_*.ts
*.log

# Internal-only docs and AI tooling. Private company project: these stay on
# local disk and must never reach the remote. NOTE: they were already
# pushed before this rule existed, so they remain in the remote's HISTORY
# until it is rewritten — untracking only stops future commits.
AGENTS.md
CLAUDE.md
PROJECT_SPECIFICATION.md
.agents/
graphify-out/

# supabase CLI scratch
supabase/.temp/
